      "name": "r4_gk",
      "description": "redesign_4 deterministic player, seat 0 (GK)",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/player",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "instrumentation": { "enableOtel": false },
      "envVars": [
